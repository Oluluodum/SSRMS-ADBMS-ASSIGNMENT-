# Use a dedicated, non-superuser runtime login. Do not commit real credentials.
DATABASE_URL="postgresql://ssrms_app:CHANGE_ME@localhost:5432/ssrms?schema=public"
# Prisma migration/seed account; keep separate from the runtime account.
MIGRATION_DATABASE_URL="postgresql://ssrms_migrator:CHANGE_ME@localhost:5432/ssrms?schema=public"
JWT_SECRET="replace-with-at-least-32-random-bytes"
PORT=3000
NODE_ENV=development
